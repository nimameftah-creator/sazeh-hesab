# ═══════════════════════════════════════════════════════════
# دفتر ساختمان — فایل تنظیمات
# ═══════════════════════════════════════════════════════════
# این فایل را کپی کن به نام  .env  و مقدارش را تنظیم کن.
#
#   کپی در ویندوز:  copy .env.example .env
#   کپی در مک:      cp .env.example .env
# ═══════════════════════════════════════════════════════════

# ── آدرس دیتابیس PostgreSQL ──────────────────────────────
# اگر با docker-compose بالا آوردی، همین مقدار درست است:
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# اگر PostgreSQL را جدا نصب کردی و رمز دیگری دادی، عوضش کن:
# DATABASE_URL=postgresql://postgres:رمز_تو@127.0.0.1:5432/app_db

# اگر از دیتابیس ابری (Neon، Supabase و...) استفاده می‌کنی:
# DATABASE_URL=postgresql://user:pass@host.neon.tech/dbname?sslmode=require
